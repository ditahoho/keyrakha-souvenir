{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/products", "destination": "/produk", "permanent": true },
    { "source": "/about", "destination": "/tentang", "permanent": true },
    { "source": "/contact", "destination": "/kontak", "permanent": true },
    { "source": "/admin/index", "destination": "/admin", "permanent": true }
  ],
  "rewrites": [
    { "source": "/produk", "destination": "/products" },
    { "source": "/produk/:slug", "destination": "/product?slug=:slug" },
    { "source": "/tentang", "destination": "/about" },
    { "source": "/kontak", "destination": "/contact" },
    { "source": "/admin", "destination": "/admin/index" }
  ]
}
