{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products.html",
      "destination": "/produk",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/tentang",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/kontak",
      "permanent": true
    },
    {
      "source": "/admin/index.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/admin/login.html",
      "destination": "/admin/login",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/produk",
      "destination": "/products.html"
    },
    {
      "source": "/produk/:slug",
      "destination": "/product.html?slug=:slug"
    },
    {
      "source": "/tentang",
      "destination": "/about.html"
    },
    {
      "source": "/kontak",
      "destination": "/contact.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    }
  ]
}